# ── Reproducibility ────────────────────────────────────────────────────────
# Every RNG in the generator derives from this single integer.
MASTER_SEED=20260907

# Frozen "now" that all temporal reasoning resolves against.
# Default is PINNED (fixed timestamp) so `make seed` is byte-identical every run.
# Set NOW_ANCHOR=live for a fresh "last 30 days" window at wall-clock time.
NOW_ANCHOR=2026-09-07T00:00:00+00:00

# ── Generation shape ───────────────────────────────────────────────────────
SAMPLE_SECONDS=60
WINDOW_DAYS=30
MAINTENANCE_HISTORY_MONTHS=24
CURRENCY=INR

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Host runs: use localhost. The app container overrides PG_HOST=postgres via compose.
PG_HOST=localhost
PG_PORT=5432
PG_DB=mas
PG_USER=mas
PG_PASSWORD=mas_pw
# Read-only role the (future) SQL agent connects as.
PG_READER_USER=mas_reader
PG_READER_PASSWORD=mas_reader_pw

# ── Neo4j ──────────────────────────────────────────────────────────────────
# Host runs: use localhost. The app container overrides NEO4J_URI via compose.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mas_neo4j_pw
NEO4J_DATABASE=neo4j

# ── Gemini (required for the agents; the data layer runs without it) ───────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── LangSmith tracing (optional; full nested observability) ────────────────
# Captures every nested run: orchestrator -> specialist -> tool -> LLM call,
# with full prompts, the exact SQL/Cypher, tokens and latency.
# Get a free key at https://smith.langchain.com/ then set these in .env:
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mas-industrial-analytics
